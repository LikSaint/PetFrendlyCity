# Copy this file to .env.local. Keep every local key/credential there.
# Never commit .env.local or paste its values into issues, logs, or chat.

APP_ENV=local
PUBLIC_WEB_URL=http://localhost:4200
ADMIN_WEB_URL=http://localhost:4300

# Supabase hosted project (local development can leave these empty).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Use separately restricted keys for every platform and server workload.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=

# Transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Push credentials (Phase 3/4).
FCM_SERVICE_ACCOUNT_JSON_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_BASE64=

# Object storage migration target (not required on MVP/Supabase Storage).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
